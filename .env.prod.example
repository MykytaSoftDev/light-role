# ──────────────────────────────────────────────────────────────
# PROD env template — copy to .env.prod, then fill every `# CHANGE ME`.
#   cp .env.prod.example .env.prod
# Used by: docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#            --env-file .env.prod ...  (see Makefile `prod-*` targets)
# .env.prod is gitignored. NEVER commit real secrets. This file (*.example)
# is committed and must contain only placeholders.
#
# Generate strong secrets with:  openssl rand -hex 32
# ──────────────────────────────────────────────────────────────

# ── Compose ───────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=lightrole_prod

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
COOKIE_SECURE=true
COOKIE_DOMAIN=.lightrole.com

# ── Domains (drive nginx envsubst + cert paths) ───────────────
DOMAIN=lightrole.com
API_DOMAIN=api.lightrole.com
CERT_DOMAIN=lightrole.com
LETSENCRYPT_EMAIL=                      # CHANGE ME (e.g. admin@lightrole.com)

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=lightrole
POSTGRES_PASSWORD=                      # CHANGE ME
POSTGRES_DB=lightrole

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=                         # CHANGE ME

# ── JWT / app secret ──────────────────────────────────────────
SECRET_KEY=                             # CHANGE ME (openssl rand -hex 32)

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=https://lightrole.com
# Internal (container-to-container) URLs — defaults in base compose are fine.
FRONTEND_INTERNAL_URL=http://frontend:3000
INTERNAL_API_URL=http://backend:8000
INTERNAL_RENDER_SECRET=                 # CHANGE ME (openssl rand -hex 32)

# ── Third-party ───────────────────────────────────────────────
OPENAI_API_KEY=                         # CHANGE ME
RESEND_API_KEY=                         # CHANGE ME
RESEND_FROM_EMAIL=noreply@lightrole.com
SENTRY_DSN=                             # CHANGE ME (optional but recommended)
GOOGLE_CLIENT_ID=                       # CHANGE ME
GOOGLE_CLIENT_SECRET=                   # CHANGE ME

# ── Paddle (production) ───────────────────────────────────────
PADDLE_API_KEY=                         # CHANGE ME
PADDLE_WEBHOOK_SECRET=                  # CHANGE ME
PADDLE_ENVIRONMENT=production

# ── Frontend NEXT_PUBLIC_* (baked into the build) ─────────────
NEXT_PUBLIC_API_URL=https://api.lightrole.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=           # CHANGE ME (same as GOOGLE_CLIENT_ID)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=        # CHANGE ME
NEXT_PUBLIC_PADDLE_ENVIRONMENT=production
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_MONTHLY=         # CHANGE ME (pri_...)
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_ANNUAL=          # CHANGE ME (pri_...)
NEXT_PUBLIC_PADDLE_PRICE_ID_UNLIMITED_MONTHLY=   # CHANGE ME (pri_...)
NEXT_PUBLIC_PADDLE_PRICE_ID_UNLIMITED_ANNUAL=    # CHANGE ME (pri_...)
