# ──────────────────────────────────────────────────────────────
# LOCAL env template — copy to .env.local, then `make up`.
#   cp .env.local.example .env.local
# Sensible dev defaults; the only thing you usually fill is OPENAI_API_KEY.
# .env.local is gitignored. This file (*.example) is committed.
# ──────────────────────────────────────────────────────────────

# ── Compose ───────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=lightrole_local

# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=lightrole
POSTGRES_PASSWORD=lightrole
POSTGRES_DB=lightrole

# ── Redis (auth required even in local) ───────────────────────
REDIS_PASSWORD=localdevpassword

# ── JWT / app secret (dev only — DO NOT use in prod) ──────────
SECRET_KEY=dev-secret-key-not-for-production-use-openssl-rand-hex-32

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Internal (container-to-container) URLs — defaults in base compose are fine.
FRONTEND_INTERNAL_URL=http://frontend:3000
INTERNAL_API_URL=http://backend:8000
# Shared secret for the internal render Route Handler (TAILOR-4).
INTERNAL_RENDER_SECRET=dev-internal-render-secret

# ── Third-party (dev keys / sandbox) ──────────────────────────
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-pinned OAuth redirect_uri — must match the SPA callback route and be
# registered as an Authorized redirect URI in the Google Cloud OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ── Paddle (sandbox) ──────────────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# ── Frontend NEXT_PUBLIC_* (baked into the build) ─────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_MONTHLY=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_ANNUAL=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_ID_UNLIMITED_MONTHLY=pri_xxx
NEXT_PUBLIC_PADDLE_PRICE_ID_UNLIMITED_ANNUAL=pri_xxx
